{
  "name": "hop",
  "productName": "Hop",
  "version": "0.2.1",
  "description": "AirDrop-style file transfer between Mac and Windows over your local network.",
  "author": "0xCodez",
  "license": "MIT",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/smoke.js",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.0xcodez.hop",
    "productName": "Hop",
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Hop-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Hop finds your other computers on the local network to send files to them."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Hop-windows-${arch}.${ext}",
      "oneClick": true,
      "perMachine": false
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  }
}
